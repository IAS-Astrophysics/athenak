# Magnetized uniform inertial-rest reservoir; beta_inf=1, rB=500, a=32.
# Low-resolution pilot: dx=0.03125 M, mask radius/dx=16.
<job>
basename = magnetic_bondi_binary
<mesh>
nghost = 4
nx1 = 32
nx2 = 32
nx3 = 32
x1min = -2048
x1max = 2048
x2min = -2048
x2max = 2048
x3min = -2048
x3max = 2048
ix1_bc = user
ox1_bc = user
ix2_bc = user
ox2_bc = user
ix3_bc = user
ox3_bc = user
<meshblock>
nx1 = 8
nx2 = 8
nx3 = 8
<mesh_refinement>
refinement = adaptive
num_levels = 13
# 118 initial blocks/rank on 12 tiles; reserve 128 without changing resolution.
max_nmb_per_rank = 128
ncycle_check = 1
refinement_interval = 1
# Resolve each physical horizon at m_hole/16; no binary COM fine patch.
<refined_region1>
level = 12
x1min = 15.5
x1max = 16.5
x2min = -0.5
x2max = 0.5
x3min = -0.5
x3max = 0.5
<refined_region2>
level = 12
x1min = -16.5
x1max = -15.5
x2min = -0.5
x2max = 0.5
x3min = -0.5
x3max = 0.5
<amr_criterion1>
method = cyclic_zoom
bondi_mhd_schedule = true
residence_scale = 1.0
nlevels = 8
ncenters = 1
x1c = 0
r_0 = 0.5
f_ref = 4
f_exc = 0
trun_fac = 10
trun_pow = 1.5
<cyclic_zoom>
verbose = true
max_nzmb_per_dvce = 128
max_nzmb_per_host = 128
<time>
evolution = dynamic
integrator = rk2
cfl_number = 0.25
nlim = -1
tlim = 20000
ndiag = 100
<coord>
smooth_excision = true
general_rel = true
a = 0
excise = true
excision_scheme = puncture
excise_1_rad = 0.8
excise_2_rad = 0.8
dexcise = 1e-8
pexcise = 1e-12
require_resolved_horizon = true
<mhd>
dyn_flux_team_size = 64
eos = ideal
dyn_eos = ideal
dyn_error = reset_floor
reconstruct = ppm4
rsolver = hlle
gamma = 1.6666666666666667
dfloor = 1e-10
pfloor = 1e-14
tfloor = 1e-12
fofc = true
gamma_max = 10
enforce_maximum = false
calculate_tmunu = false
<adm>
dynamic = false
<problem>
initial_condition = bondi_reservoir
# No initial cavity; all outer faces maintain the uniform inertial-rest reservoir.
bondi_cavity_radius = 0
bondi_cavity_fraction = 0
bondi_cavity_core_fraction = 0
bondi_cache_boundary = true
single_black_hole = false
corotating = true
sep = 32
q = 1
frame_omega = 0.005524271728019903
a1 = 0
a2 = 0
r_crit = 8
k_adi = 1
b_inf = 0
rho_inf = 1
r_bondi = 500
beta_inf = 1
reservoir_pressure_perturbation = 0.02
metric_derivative = ad
user_hist = false
<output1>
ghost_zones = true
file_type = bin
variable = mhd_w_bcc
dt = 50
<output2>
ghost_zones = true
file_type = bin
variable = adm
dt = 500
<output3>
file_type = bin
variable = mhd_divb
dt = 50
<output4>
file_type = rst
dt = 500
