# Magnetized uniform inertial-rest reservoir; beta_inf=1, rB=500, a=32.
# Low-resolution pilot: dx=0.0625 M, mask radius/dx=8.
<job>
basename = magnetic_bondi_binary
<mesh>
nghost = 4
nx1 = 16
nx2 = 16
nx3 = 16
x1min = -32
x1max = 32
x2min = -32
x2max = 32
x3min = -32
x3max = 32
ix1_bc = user
ox1_bc = user
ix2_bc = user
ox2_bc = user
ix3_bc = user
ox3_bc = user
<meshblock>
nx1 = 4
nx2 = 4
nx3 = 4
<mesh_refinement>
refinement = adaptive
num_levels = 5
max_nmb_per_rank = 1000
ncycle_check = 1
refinement_interval = 1
# Resolve each physical horizon at m_hole/4; no binary COM fine patch.
<refined_region1>
level = 4
x1min = 1.75
x1max = 2.25
x2min = -.25
x2max = .25
x3min = -.25
x3max = .25
<refined_region2>
level = 4
x1min = -2.25
x1max = -1.75
x2min = -.25
x2max = .25
x3min = -.25
x3max = .25
<amr_criterion1>
method = cyclic_zoom
bondi_mhd_schedule = true
residence_scale = 1e-06
nlevels = 5
ncenters = 1
x1c = 0
r_0 = 0.5
f_ref = 4
f_exc = 0
trun_fac = 10
trun_pow = 1.5
<cyclic_zoom>
verbose = true
max_nzmb_per_dvce = 1000
max_nzmb_per_host = 1000
<time>
evolution = dynamic
integrator = rk2
cfl_number = 0.25
nlim = 18
tlim = 10
ndiag = 1
<coord>
general_rel = true
a = 0
excise = true
excision_scheme = puncture
excise_1_rad = 0.8
excise_2_rad = 0.8
dexcise = 1e-8
pexcise = 1e-12
require_resolved_horizon = false
<mhd>
dyn_flux_team_size = 64
eos = ideal
dyn_eos = ideal
dyn_error = reset_floor
reconstruct = ppm4
rsolver = hlle
gamma = 1.6666666666666667
dfloor = 1e-10
pfloor = 1e-14
tfloor = 1e-12
fofc = true
gamma_max = 10
enforce_maximum = false
calculate_tmunu = false
<adm>
dynamic = false
<problem>
initial_condition = bondi_reservoir
# Optional initial cavity only; exterior feeding remains the Michel solution.
bondi_cavity_radius = 0
bondi_cavity_fraction = 0
bondi_cavity_core_fraction = 0
bondi_cache_boundary = true
single_black_hole = false
corotating = true
sep = 4
q = 1
frame_omega = 0.125
a1 = 0
a2 = 0
r_crit = 8
k_adi = 1
b_inf = 0
rho_inf = 1
r_bondi = 500
beta_inf = 1
reservoir_pressure_perturbation = 0.02
metric_derivative = ad
user_hist = false
<output1>
file_type = bin
dcycle = 1
variable = mhd_w_bcc
dt = 50
<output2>
file_type = bin
dcycle = 1
variable = adm
dt = 500
<output3>
file_type = bin
dcycle = 1
variable = mhd_divb
dt = 50
<output4>
file_type = rst
dcycle = 9
dt = 500
