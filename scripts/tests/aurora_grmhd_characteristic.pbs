#!/bin/bash
#PBS -A MHDTidal
#PBS -q capacity
#PBS -N cz_characteristic
#PBS -l select=1
#PBS -l walltime=01:00:00
#PBS -l filesystems=flare:home
#PBS -j oe
set -euo pipefail
cd "$PBS_O_WORKDIR"
trial="${CZ_BOUNDARY_TRIAL:?New isolated trial directory required}"
[[ "$trial" = /* && -d "$trial" && ! -e "$trial/started.txt" ]] || exit 2
printf '%s\n' "$PBS_JOBID" > "$trial/started.txt"
source source-characteristic/scripts/tests/aurora_sane_environment.sh runtime
export ONEAPI_DEVICE_SELECTOR=level_zero:gpu
export SYCL_CACHE_PERSISTENT=1 SYCL_CACHE_DIR="$PWD/sycl-cache"
export KOKKOS_TOOLS_LIBS="$PWD/memory_guard.so"
export CZ_NRANKS=12 CZ_RSS_GB=1.2 CZ_SECONDS=600 CZ_KOKKOS_TOTAL_BYTES=14000000000
export OPENBLAS_NUM_THREADS=1
sha256sum -c build-characteristic/executable.sha256 > "$trial/executable-verification.txt"
sha256sum -c "$trial/source.sha256" > "$trial/source-verification.txt"
module list > "$trial/modules.txt" 2>&1
SECONDS=0
bind='list:1-8:9-16:17-24:25-32:33-40:41-48:53-60:61-68:69-76:77-84:85-92:93-100'
# Native full-solver wave tests use a flat ADM limit of the GRMHD solver,
# periodic transverse directions and physical user boundaries along z.
for nz in 32 64; do
 for mode in acoustic alfven; do
  for choice in reference fixed characteristic; do
   boundary=$choice; mesh_nz=$nz; zhalf=8
   if [[ $choice == reference ]]; then boundary=fixed; mesh_nz=$((3*nz)); zhalf=24; fi
   export CZ_OUT="$trial/${mode}-${choice}-${nz}"
   (( SECONDS < 2700 )) || { echo "Batch stopped before starting a case near the wall limit"; exit 4; }
   mkdir "$CZ_OUT"
   args=(mesh_refinement/refinement=none mesh/nx1=16 mesh/nx2=16 "mesh/nx3=$mesh_nz"
    coord/excise=false coord/require_resolved_horizon=false
    problem/single_black_hole=true problem/reservoir_test_flat_metric=true
    problem/reservoir_pressure_perturbation=0 problem/corotating=false problem/frame_omega=0
    "problem/reservoir_boundary=$boundary" problem/reservoir_test_pulse=0.01 "problem/reservoir_test_pulse_mode=$mode"
    time/tlim=180 time/nlim=50000 output1/dt=180 output2/dt=180 output3/dt=180 output4/dt=0
    mesh/ix1_bc=periodic mesh/ox1_bc=periodic mesh/ix2_bc=periodic mesh/ox2_bc=periodic)
   for d in 1 2 3; do
    half=8; if [[ $d == 3 ]]; then half=$zhalf; fi
    args+=("mesh/x${d}min=-$half" "mesh/x${d}max=$half")
   done
   printf '%s\n' "${args[@]}" > "$CZ_OUT/overrides.txt"
   mpiexec -n 12 -ppn 12 --cpu-bind "$bind" bash source-characteristic/scripts/tests/aurora_benchmark_rank.sh \
    ./build-characteristic/src/athena -i "$trial/input.athinput" -d "$CZ_OUT" -t 00:55:00 "${args[@]}" \
    > "$CZ_OUT/launcher.log" 2>&1
  done
 done
done
# Real binary ADM, production box/rotation, original hierarchy and smooth drain:
# one bounded smoke control (NOT a new physical continuation).
for boundary in fixed characteristic; do
export CZ_OUT="$trial/curved-amr-$boundary"
(( SECONDS < 2700 )) || exit 4
mkdir "$CZ_OUT"
mpiexec -n 12 -ppn 12 --cpu-bind "$bind" bash source-characteristic/scripts/tests/aurora_benchmark_rank.sh \
 ./build-characteristic/src/athena -i "$trial/input.athinput" -d "$CZ_OUT" -t 00:55:00 \
 "problem/reservoir_boundary=$boundary" problem/reservoir_test_flat_metric=false problem/reservoir_test_pulse=0 \
 problem/reservoir_pressure_perturbation=0 coord/smooth_excision=true coord/require_resolved_horizon=false \
 output1/ghost_zones=false output2/ghost_zones=false \
 time/tlim=0.05 time/nlim=100 output1/dt=0.05 output2/dt=0.05 output3/dt=0.05 output4/dt=0 \
 > "$CZ_OUT/launcher.log" 2>&1
done
printf 'all solver tests exited zero; fields/resources still require audit\n' > "$trial/completed.txt"
