#!/bin/bash
#PBS -A MHDTidal
#PBS -q debug
#PBS -N cz_lowres_long
#PBS -l select=1
#PBS -l walltime=01:00:00
#PBS -l filesystems=flare:home
#PBS -j oe
set -euo pipefail
cd "$PBS_O_WORKDIR"
source source/scripts/tests/aurora_sane_environment.sh runtime
export ONEAPI_DEVICE_SELECTOR=level_zero:gpu
export SYCL_CACHE_PERSISTENT=1 SYCL_CACHE_DIR="$PWD/sycl-cache"
export KOKKOS_TOOLS_LIBS="$PWD/memory_guard.so"
export CZ_NRANKS=12 CZ_RSS_GB=1 CZ_SECONDS=3480
export CZ_OUT="$PWD/evolution-lowres-${PBS_JOBID%%.*}"
mkdir "$CZ_OUT"
module list > "$CZ_OUT/modules.txt" 2>&1
ldd build-sane/src/athena > "$CZ_OUT/libraries.txt"
grep -q 'mpich-5.0.0.aurora_test.51a9474-' "$CZ_OUT/libraries.txt"
sha256sum build-sane/src/athena > "$CZ_OUT/executable.sha256"
cp source/inputs/dyngr/bondi_hierarchy/binary_lowres.athinput "$CZ_OUT/input.athinput"
printf '%s\n' "$PBS_JOBID" > "$CZ_OUT/job-id.txt"
bind='list:1-8:9-16:17-24:25-32:33-40:41-48:53-60:61-68:69-76:77-84:85-92:93-100'
mpiexec -n 12 -ppn 12 --cpu-bind "$bind" bash source/scripts/tests/aurora_benchmark_rank.sh \
 ./build-sane/src/athena -i "$CZ_OUT/input.athinput" -d "$CZ_OUT" -t 00:55:00 \
 > "$CZ_OUT/launcher.log" 2>&1
