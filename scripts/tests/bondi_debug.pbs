#!/bin/bash
#PBS -A MHDTidal
#PBS -q debug
#PBS -N czbondi1012
#PBS -l select=1
#PBS -l walltime=00:30:00
#PBS -l filesystems=flare:home
#PBS -j oe
set -euo pipefail
cd "$PBS_O_WORKDIR"
module load oneapi/release/2025.3.1
module -t list 2> results/modules.txt
export ONEAPI_DEVICE_SELECTOR=level_zero:gpu
export ZE_FLAT_DEVICE_HIERARCHY=COMPOSITE
export ZE_AFFINITY_MASK=0
export OMP_NUM_THREADS=1
export SYCL_CACHE_PERSISTENT=1
export SYCL_CACHE_DIR="$PWD/sycl-cache"
export KOKKOS_TOOLS_LIBS="$PWD/kokkos_memory_guard.so"
export KOKKOS_MEMORY_BUDGET_BYTES=24000000000
sha256sum build-sycl2025/src/athena > results/executable.sha256
/usr/bin/python3.11 source/scripts/tests/run_bondi_campaign.py --root "$PWD"
