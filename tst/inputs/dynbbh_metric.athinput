<comment>
problem = small dynbbh ADM metric derivative regression

<job>
basename = dynbbh_metric

<mesh>
nghost = 4
nx1 = 8
x1min = 60.0
x1max = 300.0
ix1_bc = outflow
ox1_bc = outflow
nx2 = 5
x2min = -2.5
x2max = 2.5
ix2_bc = outflow
ox2_bc = outflow
nx3 = 5
x3min = -2.5
x3max = 2.5
ix3_bc = outflow
ox3_bc = outflow

<meshblock>
nx1 = 8
nx2 = 5
nx3 = 5

<mesh_refinement>
refinement = none
num_levels = 1
refinement_interval = 2
max_nmb_per_rank = 512

<amr_criterion0>
method = user

<time>
evolution = dynamic
integrator = rk2
cfl_number = 0.4
nlim = 0
tlim = 0.0
ndiag = 1

<coord>
general_rel = true
m = 1.0
a = 0.0
excise = true
excision_scheme = fixed
dexcise = 1.0e-8
pexcise = 3.33e-11
texcise = -1.0
excise_1_rad = -1.0
excise_2_rad = -1.0
excise_cap_to_horizon = false
excise_to_horizon = false
excise_shrink_to_horizon = false
excise_shrink_timescale = 50.0
excise_shrink_start_time = 0.0
require_resolved_horizon = false
smooth_excision = false
smooth_excision_width = 1.0
smooth_excision_puncture_weight_exponent = 1.0
smooth_excision_puncture_width_fraction = 1.0
puncture_flux_excision_radius_factor = 1.0
smooth_excision_sigma_max = -1.0
smooth_excision_temp_ceil = -1.0
smooth_excision_inflow = false
smooth_excision_inflow_speed = 0.0
smooth_excision_b_damping = false
smooth_excision_b_damping_eta = 0.0
smooth_excision_b_damping_cfl = 0.25

<mhd>
eos = ideal
dyn_eos = ideal
dyn_error = reset_floor
reconstruct = plm
rsolver = hlle
dfloor = 1.0e-10
pfloor = 1.0e-18
tfloor = 1.0e-8
gamma = 1.44444444444
fofc = true
gamma_max = 20.0
enforce_maximum = false
calculate_tmunu = true

<adm>
dynamic = true

<problem>
sep = 25.0
q = 2.0
a1 = 0.93
a2 = 0.88
th_a1 = 37.0
ph_a1 = 123.0
th_a2 = 71.0
ph_a2 = -41.0
a1_buffer = 0.0
a2_buffer = 0.0
cutoff_floor = 1.0e-10
metric_derivative = finite_difference
metric_fd_step = 5.0e-5
use_traj_table = false
traj_file = none
spin_ramp = false
spin_ramp_start_time = 0.0
spin_ramp_timescale = 50.0
user_hist = false
flux_ntheta = 16
flux_nphi = 32
flux_interp_order = 1
flux_rsurf_inner = -1.0
flux_rsurf_outer = -1.0
flux_dr_surf = 1.0
flux_horizon1 = false
flux_horizon2 = false
flux_radius1 = -1.0
flux_radius2 = -1.0
amr_condition = none
radius_thr = 5.0
alpha_thr = 0.8
tracker_reflevel = -1
tracker_1_rad = 5.0
tracker_2_rad = 5.0
tracker_1_reflevel = -1
tracker_2_reflevel = -1
refinement_hysteresis = 1.25
radius_0_rad = 1.0
radius_0_reflevel = 0
dfloor = 1.0e-10
pfloor = 1.0e-18
unresolved_sink = false
sink_radius = 0.0
sink_width = -1.0
sink_timescale = 1.0
sink_density_floor = -1.0
sink_pressure_floor = -1.0
sink_cells_per_radius = 2.0
sink_resolved_cells_across_horizon = 8.0
test_bz_gradient = 0.0
initialize_torus = false
r_edge = 400.0
r_peak = 800.0
rho_max = 1.0
rho_min = 1.0e-10
rho_pow = 0.0
pgas_min = 1.0e-18
pgas_pow = 0.0
pert_amp = 0.0
potential_beta_min = 100.0
potential_cutoff = 0.2
potential_rho_pow = 1.0

<output1>
file_type = tab
variable = adm
data_format = %.17e
dt = 1.0
dcycle = 1
slice_x2 = 0.0
slice_x3 = 0.0
# These are ignored for tabular output but allow the hardening regression to
# switch this block to PDF output from the command line.
bin_min = 0.0
bin_max = 1.0
nbin = 8
logscale = false

<output2>
file_type = hst
dt = 1.0

<output3>
file_type = bin
variable = mhd_w
dt = 1.0
dcycle = -1
