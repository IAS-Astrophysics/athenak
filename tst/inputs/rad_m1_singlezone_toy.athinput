# Regression test: grey M1 single zone with constant emissivity and absorption.
#
# The periodic box lies entirely inside the emitting sphere of the rad_m1_spheretest
# toy opacity model (radius 1), so every cell has eta = kappa_abs = 10, no scattering,
# flat space and a fluid at rest.  The radiation starts at zero and stays uniform, so
# the fluxes vanish and E obeys dE/dt = eta - kappa E, i.e. E(t) = 1 - exp(-10 t).
# test_suite/m1/test_m1_singlezone_cpu.py compares the tab outputs of E with that
# solution and checks the convergence of the error with the time step.

<comment>
problem = grey M1 single zone, constant emission/absorption

<job>
basename = m1_singlezone

<mesh>
nghost = 2
nx1    = 8
x1min  = -0.25
x1max  = 0.25
ix1_bc = periodic
ox1_bc = periodic

nx2    = 1
x2min  = -0.25
x2max  = 0.25
ix2_bc = periodic
ox2_bc = periodic

nx3    = 1
x3min  = -0.25
x3max  = 0.25
ix3_bc = periodic
ox3_bc = periodic

<meshblock>
nx1 = 8
nx2 = 1
nx3 = 1

<time>
evolution  = dynamic
integrator = rk2
cfl_number = 0.4
tlim       = 0.5
nlim       = -1

<adm>

# Production settings: everything not listed takes the code default
<radiation_m1>
opacity_type   = toy         # analytic eta = kappa = 10 inside the sphere
# defaults, listed only so the test can override them on the command line
src_update        = implicit
source_thin_limit = 0.3333333333333333
source_epsrel     = 1e-5

<problem>
pgen_name = rad_m1_spheretest

<output1>
file_type = tab
variable  = rad_m1_moments
dt        = 0.05
data_format = %.17e
