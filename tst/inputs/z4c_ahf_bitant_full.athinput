# AthenaK input file: apparent-horizon finding, FULL domain.
# Regression test for bitant-aware apparent-horizon finding (FastFlow).
#
# A single Brill-Lindquist puncture at the origin. Its apparent horizon is exactly
# symmetric under reflection about z=0, and for M=1 in isotropic coordinates it sits at
# r = M/2 with area = 16*pi*M^2 and irreducible mass M_irr = 1 -- so this setup gives both
# a full-vs-bitant comparison and an absolute answer to check against.
#
# Paired with z4c_ahf_bitant_half.athinput, which is identical except for the x3 extent
# and inner-x3 boundary. NOTE: nx3/meshblock nx3 are chosen so that z=0 falls on a
# MeshBlock boundary here, making the z>0 block geometry identical between the two runs.

<comment>
problem   = z4c one puncture (bitant apparent-horizon regression: full domain)
reference = e.g. Cook. Living Rev. Relativ. 3, 5 (2000)

<job>
basename  = ahf_full

<mesh>
nghost    = 2
nx1       = 32
x1min     = -2.0
x1max     =  2.0
ix1_bc    = outflow
ox1_bc    = outflow

nx2       = 32
x2min     = -2.0
x2max     =  2.0
ix2_bc    = outflow
ox2_bc    = outflow

nx3       = 32
x3min     = -2.0
x3max     =  2.0
ix3_bc    = outflow
ox3_bc    = outflow

<meshblock>
nx1       = 16
nx2       = 16
nx3       = 16

<time>
evolution  = dynamic
integrator = rk4
cfl_number = 0.25
nlim       = 2          # FindHorizon runs at stage == nexp_stages, so >= 1 cycle
tlim       = 100.0

<z4c>
# Gauge parameters
lapse_oplog     = 2.0
lapse_harmonicf = 1.0
lapse_harmonic  = 0.0
lapse_advect    = 1.0
shift_eta       = 2.0
shift_advect    = 1.0

# Dissipation parameters
diss            = 0.02
chi_div_floor   = 1e-05

# Constraint damping
damp_kappa1     = 0.02
damp_kappa2     = 0.0

# No compact object tracker. The puncture is static and sits at the origin, so FastFlow is
# given a fixed center below (use_puncture_0 = -1) instead. This deliberately keeps the
# test dependent only on the horizon finder, not on tracker behaviour under bitant.

<fastflow>
npunct = 0
num_horizons = 1

store_metric_drvts = false

ntheta = 10             # nphi = 2*ntheta
lmax = 6

use_puncture_0 = -1     # -1: use the fixed center below rather than a tracker position
initial_radius_0 = 0.5  # analytic horizon radius for M=1 in isotropic coordinates
center_x_0 = 0.0
center_y_0 = 0.0
center_z_0 = 0.0

flow_iterations_0 = 200
flow_alpha_beta_const_0 = 1.0
hmean_tol_0 = 100.0
mass_tol_0 = 1e-6       # tight, so the surface is well converged

start_time_0 = 0.0
stop_time_0 = 100.0

output_ylm = false
output_grid = false
verbose = false

<problem>
# A boosted puncture with zero boost velocity is just a static Brill-Lindquist puncture,
# i.e. Schwarzschild in isotropic coordinates. Used here (rather than z4c_one_puncture)
# because it is a built-in pgen and so needs no custom PROBLEM= build.
pgen_name = z4c_boosted_puncture
punc_ADM_mass = 1.      # puncture mass
punc_center_x1 = 0.
punc_center_x2 = 0.
punc_center_x3 = 0.
punc_velocity_x1 = 0.
punc_velocity_x2 = 0.
punc_velocity_x3 = 0.
