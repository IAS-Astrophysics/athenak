<comment>
problem = flat-spacetime radiation beam with dyn_radiation ADM geometry

<job>
basename = dynrad_beam

<mesh>
nghost = 2
nx1 = 32
x1min = -1.0
x1max = 3.0
ix1_bc = user
ox1_bc = user
nx2 = 16
x2min = -1.0
x2max = 1.0
ix2_bc = user
ox2_bc = user
nx3 = 1
x3min = -0.5
x3max = 0.5
ix3_bc = periodic
ox3_bc = periodic

<meshblock>
nx1 = 16
nx2 = 8
nx3 = 1

<mesh_refinement>
refinement = none

<coord>
general_rel = true
minkowski = true

<adm>
dynamic = false

<time>
evolution = dynamic
integrator = rk2
cfl_number = 0.25
nlim = -1
tlim = 1.5

<dyn_radiation>
geometry = adm
nlevel = 2
rotate_geo = false
angular_fluxes = true
reconstruct = plm

<rad_srcterms>
rad_beam = true
dii_dt = 1.0
pos_1 = -0.75
pos_2 = 0.0
pos_3 = 0.0
dir_1 = 1.0
dir_2 = 0.0
dir_3 = 0.0
width = 0.5
spread = 40.0

<problem>
pgen_name = rad_beam

<output1>
file_type = tab
variable = rad_coord
id = rad_coord
data_format = %.17e
dt = 1.5
slice_x1 = 0.5
slice_x3 = 0.0
