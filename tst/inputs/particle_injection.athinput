# Particle creation and injection regression test.

<job>
basename = particle_injection

<mesh>
nghost = 2
nx1 = 16
x1min = -1.0
x1max = 1.0
ix1_bc = periodic
ox1_bc = periodic
nx2 = 8
x2min = -1.0
x2max = 1.0
ix2_bc = periodic
ox2_bc = periodic
nx3 = 8
x3min = -1.0
x3max = 1.0
ix3_bc = periodic
ox3_bc = periodic

<meshblock>
nx1 = 8
nx2 = 8
nx3 = 8

<time>
evolution = dynamic
integrator = rk2
cfl_number = 0.8
nlim = 1
tlim = 1.0
ndiag = 1

<particles>
particle_type = cosmic_ray
ppc = 0.0
pusher = drift

<problem>
pgen_name = particle_injection
injection_cycle = 1

<output1>
file_type = pvtk
variable = prtcl_all
dcycle = 1
