<comment>
problem = homogeneous gas-radiation thermal equilibration with dyn_radiation ADM

<job>
basename = dynrad_equil

<mesh>
nghost = 2
nx1 = 4
x1min = 0.0
x1max = 4.0
ix1_bc = periodic
ox1_bc = periodic
nx2 = 4
x2min = 0.0
x2max = 1.0
ix2_bc = periodic
ox2_bc = periodic
nx3 = 4
x3min = 0.0
x3max = 1.0
ix3_bc = periodic
ox3_bc = periodic

<meshblock>
nx1 = 4
nx2 = 4
nx3 = 4

<mesh_refinement>
refinement = none

<coord>
general_rel = true
minkowski = true

<adm>
dynamic = false

<time>
evolution = dynamic
integrator = rk2
cfl_number = 0.2
nlim = -1
tlim = 1.0

<mhd>
eos = ideal
dyn_eos = ideal
dyn_error = reset_floor
reconstruct = plm
rsolver = hlle
gamma = 1.6666666666666667
dfloor = 1.0e-12
pfloor = 1.0e-14
tfloor = 1.0e-12
gamma_max = 20.0
fofc = false
calculate_tmunu = false

<dyn_radiation>
geometry = adm
rad_source = true
nlevel = 1
rotate_geo = false
angular_fluxes = false
reconstruct = plm
kappa_a = 1.0
kappa_s = 0.0
kappa_p = 0.0
arad = 1.0

<problem>
pgen_name = rad_equilibration
rho = 1.0
tgas = 2.0
trad = 1.0

<output1>
file_type = tab
variable = mhd_w
id = mhd_w
data_format = %.17e
dt = 1.0
slice_x2 = 0.5
slice_x3 = 0.5

<output2>
file_type = tab
variable = rad_coord
id = rad_coord
data_format = %.17e
dt = 1.0
slice_x2 = 0.5
slice_x3 = 0.5
