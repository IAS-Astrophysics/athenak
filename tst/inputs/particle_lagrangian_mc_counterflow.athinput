# Prescribed opposing transfers on two fine pieces of one coarse face.
# Refine only the lower-left root block so this interface crosses a two-rank split.

<job>
basename = particle_lagrangian_mc_counterflow

<mesh>
nghost = 2
nx1 = 8
x1min = -4.0
x1max = 4.0
ix1_bc = periodic
ox1_bc = periodic
nx2 = 8
x2min = -2.0
x2max = 2.0
ix2_bc = periodic
ox2_bc = periodic
nx3 = 1
x3min = -2.0
x3max = 2.0
ix3_bc = periodic
ox3_bc = periodic

<meshblock>
nx1 = 4
nx2 = 4
nx3 = 1

<mesh_refinement>
refinement = static

<refined_region1>
level = 1
x1min = -4.0
x1max = 0.0
x2min = -2.0
x2max = 0.0
x3min = -2.0
x3max = 2.0

<time>
evolution = kinematic
integrator = rk2
cfl_number = 0.3
nlim = 2
tlim = 1.0
ndiag = 1

<hydro>
eos = isothermal
iso_sound_speed = 1.0
reconstruct = dc
rsolver = advect

<particles>
particle_type = lagrangian_mc
ppc = 0.0
pusher = lagrangian_mc
random_seed = 5
check_flux_probabilities = true

<problem>
pgen_name = particle_lagrangian_mc_counterflow
user_srcs = true
outward_fraction = 0.25

<output1>
file_type = pvtk
variable = prtcl_all
dcycle = 1
