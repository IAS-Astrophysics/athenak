<comment>
problem = photon boosted-LTE test with finite v_x

<job>
basename = photon_vx

<time>
evolution  = dynamic
integrator = rk2
cfl_number = 0.005
nlim       = 300
tlim       = 1.0

<mesh>
nghost = 2
nx1    = 5
x1min  = -2.5
x1max  = 2.5
ix1_bc = periodic
ox1_bc = periodic

nx2    = 1
x2min  = -0.5
x2max  = 0.5
ix2_bc = periodic
ox2_bc = periodic

nx3    = 1
x3min  = -0.5
x3max  = 0.5
ix3_bc = periodic
ox3_bc = periodic

<meshblock>
nx1 = 5
nx2 = 1
nx3 = 1

<adm>

<mhd>
eos         = ideal
gamma       = 2.0
dyn_eos     = ideal
dyn_error   = reset_floor
reconstruct = dc
rsolver     = hlle
dfloor      = 1.0e-16
fofc        = false
enforce_maximum = false

<coord>
general_rel = true
m           = 0.0
a           = 0.0
excise      = false

<radiation_m1>
closure_fun    = eddington
src_update     = implicit
opacity_type   = photons
gr_sources     = false
matter_sources = true
backreact      = false
theta_limiter  = false

<photons>
kappa_a       = 10.0
kappa_s       = 0.0
kappa_p       = 0.0
power_opacity = false
compton       = false
arad          = 1.0

<problem>
pgen_name = rad_m1_photon_thermalization
rho       = 1.0
temp      = 1.0
erad0     = 1.0e-30
vx        = 0.3
vy        = 0.0
vz        = 0.0

<output1>
file_type = tab
variable  = rad_m1_E
dcycle    = 20

<output2>
file_type = tab
variable  = rad_m1_F
dcycle    = 20
