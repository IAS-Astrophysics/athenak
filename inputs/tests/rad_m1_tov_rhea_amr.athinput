# AMR-enabled variant of inputs/tests/rad_m1_tov_rhea.athinput: the same TOV +
# bns-nurates + Rhea flavor-mixing setup, with adaptive mesh refinement active. Exercises
# the Rhea module's AMR support: rhea_f4_in_scratch/RheaModel are sized at rank capacity
# (max(nmb_thispack, nmb_maxperrank)), so a regrid that changes the number of MeshBlocks
# on a rank must run through unchanged, with Predict() operating on the live active batch
# extent each stage.
#
# The root mesh is split into 8 MeshBlocks (2x2x2) so a single-level refinement of the
# block(s) nearest the stellar center changes nmb_thispack mid-run (one block splits into
# 8 children; 8 -> 15 on the first regrid with this setup). min_max on mhd_w_d triggers
# refinement wherever the local density exceeds value_max -- true near the TOV star's
# center, false in the low-density atmosphere -- so refinement decisions of both kinds
# are exercised while flavor_mix = rhea stays active throughout.
#
# Like its non-AMR companion, this is a CPU-tractable smoke/stability test (rk1, a
# handful of cycles), not a converged simulation. Requires: an EOSCompOSE DD2 table
# (local paths below; adjust for your system) and a toy TorchScript model at
# rhea_model_path in the working directory (not part of the repo); it shares the exact
# same model file as rad_m1_tov_rhea.athinput, generated with:
#
#   python3 scripts/make_toy_rhea_model.py toy_flavor_swap_tov.pt --gamma-code 1.0
#
# On the non-AMR companion's own dt = 0.32 and lapse alpha = 0.59-0.96, this gives
# dt*alpha*inv_tau_0 = 0.19-0.31 (lambda = 0.74-0.83): resolved, not saturated. Here the
# global dt is halved by the refined level (dx=1.6 on the finest level), giving
# dt*alpha*inv_tau_0 = 0.09-0.15 -- still comfortably resolved. backreact = false, so the
# mixing perturbs only the radiation field, not the fluid/metric.

<comment>
problem  = radiation m1 tov + Rhea flavor mixing, AMR-enabled

<job>
basename = tov_rhea_amr

<mesh>
nghost = 4       # Number of ghost cells
nx1    = 16      # number of cells in x1-direction
x1min  = 0.0     # minimum x1
x1max  = 51.2    # maximum x1
ix1_bc = reflect # inner boundary
ox1_bc = outflow # outer boundary

nx2    = 16      # number of cells in x2-direction
x2min  = 0.0     # minimum x2
x2max  = 51.2    # maximum x2
ix2_bc = reflect # inner boundary
ox2_bc = outflow # outer boundary

nx3    = 16      # number of cells in x3-direction
x3min  = 0.0     # minimum x3
x3max  = 51.2    # maximum x3
ix3_bc = reflect # inner boundary
ox3_bc = outflow # outer boundary

<meshblock>
nx1  = 8         # 2 MeshBlocks per dimension at root level (8 total) -- AMR needs more
nx2  = 8         # than 1 root block for a regrid to actually change nmb_thispack.
nx3  = 8

<mesh_refinement>
refinement = adaptive
num_levels = 2      # root decomposition (2x2x2 MeshBlocks) already counts as logical
                     # level 1 (root_level=1 here); num_levels=1 would give
                     # max_level==root_level, i.e. no room to refine at all. num_levels=2
                     # allows exactly one level of refinement beyond the root split.
refinement_interval = 1
max_nmb_per_rank = 64

<amr_criterion0>
method = min_max
variable = mhd_w_d
value_max = 1.0e-4   # between dfloor (1.28e-13) and rhoc (1.28e-3): true near the star
                      # center, false near the outer/atmosphere region.

<time>
evolution  = dynamic    # dynamic/kinematic/static
integrator = rk1        # forward Euler -- deliberate, matches the non-AMR companion file
cfl_number = 0.1
nlim       = 10         # a handful of cycles is enough to trigger + survive one regrid
tlim       = 10000
ndiag      = 1          # cycles between diagnostic output

<coord>
general_rel = true      # general relativity
m           = 1.0
a           = 0.0
excise      = false

<radiation_m1>
num_species = 4
closure_fun = minerbo
src_update = implicit
opacity_type = bns-nurates
backreact = false

flavor_mix = rhea
rhea_model_path = toy_flavor_swap_tov.pt
rhea_stability_threshold = 0.5
rhea_tau_0_factor = 1.0
rhea_tau_1_factor = 1.0

<mhd>
eos         = ideal     # EOS type
dyn_eos     = compose     # EOS type (Rhea mixing requires EOSCompOSE)
dyn_error   = reset_floor # error policy
reconstruct = wenoz     # spatial reconstruction method
rsolver     = hlle      # Riemann solver to be used
dfloor      = 1.28e-13   # floor on density rho
tfloor      = 1.28e-11
dthreshold  = 0.1       # Threshold for flooring
gamma       = 2.0       # ratio of specific heats Gamma
dyn_scratch = 0
fofc        = true
enforce_maximum = false
dmp_M       = 1.2
nscalars = 1
s0_atmosphere = 0.5
table       = /home/dradice/Data/EOS/DD2/DD2.athtab

<adm>

<z4c>
diss        = 0.1
extrap_order = 2

<problem>
table       = /home/dradice/Data/EOS/DD2/0.01MeV/DD2_cold_equal.athtab
rhoc        = 1.28e-3 # Central density
kappa       = 100.0    # P = kappa*rho^gamma
npoints     = 10000.0  # buffer points for TOV calculation
dr          = 1e-3     # radial step for TOV calculation
b_norm      = 0.0
pcut        = 1e-6
magindex    = 1
isotropic   = true
user_hist   = true
v_pert      = 0.0
rho_cut = 1.0e-7

<output1>
file_type   = hst      # History data dump
dcycle      = 1
data_format = %20.15e

<output2>
file_type   = tab
variable    = rad_m1_N
slice_x2    = 0.0
slice_x3    = 0.0
dcycle      = 1
data_format = %24.17e
