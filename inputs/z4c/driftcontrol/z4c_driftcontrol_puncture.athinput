# AthenaK input file: drift control test
#
# A single static puncture is placed off-centre at x = +1.5. With
# <z4c>/enable_driftcontrol = true the shift RHS picks up a damped restoring
# term that should drag it back to dc_fixed_x/y/z = (0,0,0). With drift control
# off the puncture just sits where it was put.

<comment>
problem   = z4c drift control on an off-centre puncture

<job>
basename  = z4c

<mesh>
nghost    = 4
nx1       = 96
x1min     = -8
x1max     = 8
ix1_bc    = outflow
ox1_bc    = outflow

nx2       = 96
x2min     = -8
x2max     = 8
ix2_bc    = outflow
ox2_bc    = outflow

nx3       = 96
x3min     = -8
x3max     = 8
ix3_bc    = outflow
ox3_bc    = outflow

<meshblock>
nx1       = 48
nx2       = 48
nx3       = 48

<time>
evolution  = dynamic
integrator = rk3
cfl_number = 0.25
nlim       = -1
tlim       = 15
ndiag      = 20

<z4c>
# Moving puncture gauge
lapse_harmonic  = 0.0
lapse_oplog     = 2.0
shift_eta       = 2.0
diss            = 0.5
chi_div_floor   = 0.00001
damp_kappa1     = 0.02
damp_kappa2     = 0.00

# Compact object tracker (drift control reads its position)
co_0_type       = BH
co_0_x          = 1.5
co_0_mass       = 1.

# Drift control
enable_driftcontrol = true
dc_variety          = oscillator   # oscillator | pid | relaxation
dc_tracker_index    = 0
dc_gaussian_center  = fixed        # fixed | tracker
dc_fixed_x          = 0.
dc_fixed_y          = 0.
dc_fixed_z          = 0.
dc_damping_scale    = 4.0          # width of the Gaussian weight
dc_damping_time     = 1.0          # tau,  oscillator only
dc_damping_coeff    = 1.0          # zeta, oscillator only
dc_vel_cap          = 1.0
dc_integral_cap     = 5.0
dc_out_every        = 1

# PID variety
dc_Kp               = 1.0
dc_Ki               = 0.1
dc_Kd               = 2.0

# Relaxation variety
dc_relaxation_time  = 1.0
dc_kappa            = 1.0
dc_gamma_suppress   = 0.0

<problem>
pgen_name        = z4c_one_puncture
punc_ADM_mass    = 1.
punc_center_x1   = 1.5

<output1>
file_type  = hst
dt         = 1

<output2>
file_type  = tab
variable   = z4c
dt         = 5
slice_x2   = 0
slice_x3   = 0
