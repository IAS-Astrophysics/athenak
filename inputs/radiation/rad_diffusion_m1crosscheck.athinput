<comment>
problem = DO diffusion cross-check for the M1 photon diffusion test

<job>
basename = do_diff

<time>
evolution  = dynamic
integrator = rk2
cfl_number = 0.4
nlim       = -1
tlim       = 40.0

<coord>
general_rel = true
minkowski   = true

<mesh>
nghost = 2
nx1    = 256
x1min  = -2.0
x1max  = 2.0
ix1_bc = periodic
ox1_bc = periodic

nx2    = 1
x2min  = -0.5
x2max  = 0.5
ix2_bc = periodic
ox2_bc = periodic

nx3    = 1
x3min  = -0.5
x3max  = 0.5
ix3_bc = periodic
ox3_bc = periodic

<hydro>
eos         = ideal
reconstruct = plm
rsolver     = hlle
gamma       = 2.0

<radiation>
nlevel       = 2
fixed_fluid  = true
affect_fluid = false
arad         = 1.0
kappa_s      = 100.0
kappa_a      = 0.0
kappa_p      = 0.0

<problem>
v1 = 0.0
nu = 2.3570226

<output1>
file_type = tab
variable  = rad_fluid
dt        = 4.0
